  {
    "id": "permissions-021",
    "categoryId": "permissions",
    "type": "short",
    "difficulty": "hard",
    "title": "应用支持“允许本次使用”这类临时授权时，业务代码应如何避免误用过期权限？",
    "explanation": "单次授权的核心是授权可能随前后台状态和系统策略失效，因此业务必须把权限视为动态状态。",
    "knowledgePoints": [
      "单次授权",
      "动态权限状态",
      "降级处理"
    ],
    "sourceRefs": [
      {
        "title": "向用户申请授权",
        "url": "https://gitee.com/openharmony/docs/blob/master/zh-cn/application-dev/security/AccessToken/request-user-authorization.md",
        "publisher": "OpenHarmony Docs"
      },
      {
        "title": "@ohos.abilityAccessCtrl（程序访问控制管理）",
        "url": "https://gitee.com/openharmony/docs/blob/master/zh-cn/application-dev/reference/apis-ability-kit/js-apis-abilityAccessCtrl.md",
        "publisher": "OpenHarmony Docs"
      }
    ],
    "verifiedAt": "2026-07-23",
    "reviewStatus": "verified",
    "status": "published",
    "order": 21,
    "referenceAnswer": "仍使用 requestPermissionsFromUser 发起系统授权，不自行模拟临时授权。每次执行受保护操作前都重新检查当前状态，不把授权结果永久缓存为真；应用进入后台、授权状态变化或重新回到功能页时，都应准备处理权限已失效的情况。失效后停止定位、相机等能力并更新 UI，再由用户明确触发重新申请。用户拒绝时给出不依赖该权限的降级路径，必要时通过系统设置引导，不循环弹窗。",
    "scoringPoints": [
      "说明仍使用系统权限申请接口",
      "每次受保护操作前重新检查，不永久缓存授权",
      "权限失效后立即停止能力并更新界面",
      "提供拒绝后的降级和设置引导"
    ]
  }
