  {
    "id": "permissions-004",
    "categoryId": "permissions",
    "type": "multiple",
    "difficulty": "medium",
    "title": "关于 PermissionRequestResult 中 authResults 的含义，哪些说法正确？",
    "options": [
      {
        "id": "a",
        "text": "0 表示权限已授予"
      },
      {
        "id": "b",
        "text": "-1 表示未授予"
      },
      {
        "id": "c",
        "text": "2 表示请求无效"
      },
      {
        "id": "d",
        "text": "200 表示权限已授予"
      }
    ],
    "correctOptionIds": [
      "a",
      "b",
      "c"
    ],
    "explanation": "PermissionRequestResult.authResults 与请求的 permissions 数组对应。官方声明说明 0 表示授权，-1 表示未授权，2 表示请求无效，不能把 HTTP 状态码 200 当作权限结果。",
    "knowledgePoints": [
